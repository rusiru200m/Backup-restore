# Copy this file to .env. Do not commit .env.
# Generate a token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_24_CHARACTERS

# Default paths on the controller. Each saved server profile can override them in the UI.
SOURCE_SSH_KEY_PATH=~/.ssh/id_ed25519
DEST_SSH_KEY_PATH=~/.ssh/id_ed25519
SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts

# Optional passphrases; keep secrets in .env, NEVER in the web form.
# SOURCE_SSH_KEY_PASSPHRASE=
# DEST_SSH_KEY_PASSPHRASE=

# Used to reject unexpectedly large files for this simple starter.
MAX_DUMP_MB=2048

# Destination SSH user must be able to write here (root in the starter walkthrough).
DEST_SAFETY_BACKUP_DIR=/var/backups/backup-restore-starter

# Persistent server profiles (contains paths and settings, never private key contents).
PROFILE_DB_PATH=state/profiles.sqlite3
# Example per-server encrypted-key passphrase, referenced by name in the UI:
# PRODUCTION_SSH_PASSPHRASE=
